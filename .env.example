# Copiez ce fichier en .env.local et remplissez les valeurs.
# Ne mettez JAMAIS .env.local sur GitHub (il est déjà ignoré).

# --- Supabase (Project Settings > API) ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clé "service_role" : secrète, utilisée uniquement côté serveur
SUPABASE_SERVICE_ROLE_KEY=

# --- Espace masseur ---
# Mot de passe pour se connecter sur /admin
ADMIN_PASSWORD=
# Chaîne aléatoire d'au moins 32 caractères (ex : `openssl rand -hex 32`)
SESSION_SECRET=

# --- Emails (https://resend.com) — facultatif en local ---
# Sans ces valeurs, les emails sont simplement affichés dans la console.
RESEND_API_KEY=
# Adresse d'expédition, sur un domaine vérifié dans Resend
EMAIL_FROM="Massage sportif <reservation@votre-domaine.fr>"

# --- Adresse publique du site (pour les liens dans les emails) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
